[mysqld]
# Local development configuration only — server settings, no credentials.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-authentication-plugin = caching_sha2_password

# Required for the CHECK constraints and JSON columns used throughout the
# approved database design (see docs/database/database-design.md).
sql_mode = "ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

max_connections = 100

[client]
default-character-set = utf8mb4
