# Base URL of the Laravel API (nginx, per docker-compose.yml). Copy to
# `.env` for local overrides — not required if this default matches your
# setup.
VITE_API_BASE_URL=http://localhost:8080

# Stripe PUBLISHABLE key (safe for client-side code — never the secret key,
# which stays backend-only as STRIPE_SECRET in backend/.env). Matches the
# same Stripe account as the backend's STRIPE_KEY. Required for the
# storefront checkout page (Block 8D) to render Stripe Elements.
VITE_STRIPE_PUBLISHABLE_KEY=
