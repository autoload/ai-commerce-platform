# Docker Compose environment — placeholders only, safe to commit.
# Copy to `.env` (gitignored) and fill in real local-dev values before
# running `docker compose up`. These values configure the `mysql` service
# and are also injected into the `app`/`queue` containers by
# docker-compose.yml so backend/.env's DB_* values never have to be kept
# in sync by hand — see docs/development/project-status.md for the full
# explanation of this pattern.

MYSQL_DATABASE=ai_commerce
MYSQL_USER=ai_commerce
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
